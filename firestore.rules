rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }

    function isOwner(storeId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function ownsStore(storeId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    // One profile doc per signed-in user, pointing at the store they belong
    // to. Only that user can read or write it.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Invite codes are how staff join a shop. The code itself is the secret,
    // so anyone signed in can look one up by code, but nobody can list them.
    // Only the shop's owner can mint or revoke codes, which is what makes an
    // invite rotatable: create a new one, delete the old one.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && ownsStore(request.resource.data.storeId);
      allow delete: if isSignedIn() && ownsStore(resource.data.storeId);
      allow update: if false;
    }

    match /stores/{storeId} {
      allow get: if isMember(storeId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isOwner(storeId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(storeId);
        // You can only ever create your OWN membership. The owner role is
        // only claimable by the uid the store records as its owner; everyone
        // else has to present a currently-valid invite code for this store,
        // so revoking a code stops further joins.
        allow create: if isSignedIn() && request.auth.uid == uid &&
          (
            (request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == uid) ||
            (request.resource.data.role == 'staff' &&
              get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.storeId == storeId)
          );
        // The owner can remove staff, but nobody can touch the owner's own
        // membership record.
        allow update, delete: if isOwner(storeId) &&
          get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid != uid;
      }

      match /items/{itemId} {
        allow read, create, update: if isMember(storeId);
        allow delete: if isOwner(storeId);
      }

      match /suppliers/{supplierId} {
        allow read, create, update: if isMember(storeId);
        allow delete: if isOwner(storeId);
      }

      // Transactions are an audit trail: any staff member can add one, and
      // nobody can ever edit one after the fact. The owner can delete them,
      // which is only used by the "clear all shop data" reset.
      match /transactions/{txId} {
        allow read, create: if isMember(storeId);
        allow update: if false;
        allow delete: if isOwner(storeId);
      }
    }
  }
}
